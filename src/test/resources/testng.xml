<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite de Automatizacion Liverpool" verbose="1">
    
    <listeners>
        <!-- Listener para capturas automáticas de pantalla en fallos -->
        <listener class-name="com.liverpool.oyentes.OyentePruebas"/>
    </listeners>

    <test name="Pruebas E2E e Intercepcion de Red">
        <classes>
            <class name="com.liverpool.pruebas.LiverpoolE2ETest"/>
        </classes>
    </test>

</suite>